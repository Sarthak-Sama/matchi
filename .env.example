# PostgreSQL + PostGIS connection string used by the API, scripts, and
# integration tests.
#
# Neon (cloud), DIRECT endpoint — the hostname WITHOUT "-pooler".
#
# Direct, not pooled, on purpose. The API is a long-running server holding a
# bounded pool of its own (max 10), so PgBouncer buys it nothing, and the
# pooler actively costs: it shares server connections between clients, so
# session state leaks. A pg_dump restore leaves `search_path` set to '' and
# every later pooled client inherits it, at which point every unqualified
# table name in this codebase stops resolving. The obvious fix — pinning
# `options=-c search_path=public` — is rejected outright by Neon's pooler,
# which tells you to use an unpooled connection instead. So: unpooled.
#
# The pooled endpoint is the right choice for serverless deployments with
# many short-lived connections. If this ever moves to one, add "-pooler"
# back and make sure every query schema-qualifies its tables first.
#
# sslmode=require, not verify-full: libpq (psql, pg_dump) refuses
# verify-full without an explicit sslrootcert, so verify-full here would
# break every command-line tool. Certificate verification is pinned in code
# instead — see shared/src/server/database-ssl.ts.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# The same database behind Neon's connection pooler ("-pooler" in the
# hostname). Not used by default — see the note above.
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Local PostGIS, for offline work. The destructive integration suites refuse
# to run against any database whose name does not end in "_test", so they
# need a local `tokyo_test` — see scripts/src/test-support/database-url.ts.
# DATABASE_URL=postgresql://tokyo:tokyo@localhost:5432/tokyo

# Port the Fastify API listens on.
PORT=4000

# Base URL the frontend (and scripts) use to reach the API.
API_BASE_URL=http://localhost:4000

# Public API base URL exposed to the browser bundle by Next.js.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Minimum log level for the API (e.g. fatal, error, warn, info, debug, trace).
LOG_LEVEL=info

# The following are optional and only needed when running the live data
# import scripts (import:mlit, import:rent, import:transit) against the real
# source APIs instead of committed fixtures.
MLIT_API_KEY=
ESTAT_APP_ID=
ODPT_ACCESS_TOKEN=
