
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# The same database behind Neon's connection pooler ("-pooler" in the
# hostname). Not used by default — see the note above.
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Local PostGIS, for offline work. The destructive integration suites refuse
# to run against any database whose name does not end in "_test", so they
# need a local `tokyo_test` — see scripts/src/test-support/database-url.ts.
# DATABASE_URL=postgresql://tokyo:tokyo@localhost:5432/tokyo

# Port the Fastify API listens on.
PORT=4000

# Base URL the frontend (and scripts) use to reach the API.
API_BASE_URL=http://localhost:4000

# Public API base URL exposed to the browser bundle by Next.js.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Minimum log level for the API (e.g. fatal, error, warn, info, debug, trace).
LOG_LEVEL=info

CORS_ORIGIN=*

RATE_LIMIT_MAX=100
RATE_LIMIT_OPTIMIZE_MAX=20

TRUST_PROXY=false

MLIT_API_KEY=
ESTAT_APP_ID=
ODPT_ACCESS_TOKEN=
