# PostgreSQL + PostGIS connection string used by the API, scripts, and
# integration tests. Matches the docker-compose.yml service credentials, and
# a local Homebrew PostGIS install configured with the same user/db.
DATABASE_URL=postgresql://tokyo:tokyo@localhost:5432/tokyo

# Port the Fastify API listens on.
PORT=4000

# Base URL the frontend (and scripts) use to reach the API.
API_BASE_URL=http://localhost:4000

# Public API base URL exposed to the browser bundle by Next.js.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Minimum log level for the API (e.g. fatal, error, warn, info, debug, trace).
LOG_LEVEL=info

# The following are optional and only needed when running the live data
# import scripts (import:mlit, import:rent, import:transit) against the real
# source APIs instead of committed fixtures.
MLIT_API_KEY=
ESTAT_APP_ID=
ODPT_ACCESS_TOKEN=
